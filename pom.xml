<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.is2.frameworks</groupId>
	<artifactId>market-jsf</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>
	<name>MarketJSF</name>
<!--
Las versiones de abajo NO son independientes entre sí: forman un
conjunto coherente
Tomcat 10.1.x -> Jakarta EE 10
Servlet 6.0 / EL 5.0 / CDI 4.0 / Faces 4.0
Si cambia la versión de Tomcat, hay que mover TODAS estas
dependencias a la vez.
-->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		
		<maven.compiler.release>17</maven.compiler.release>
		
		<!-- Versiones de la pila Jakarta EE 10 -->
		<faces.version>4.0.6</faces.version>
		<servlet.version>6.0.0</servlet.version>
		<cdi.version>4.0.1</cdi.version>
		<weld.version>5.1.5.Final</weld.version>
		<junit.version>5.10.2</junit.version>
	</properties>
	
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	
	<dependencies>
	<!--
	Jakarta Faces (JSF) - implementación Mojarra.
	Tomcat es un contenedor de servlets, NO un servidor Jakarta EE
	completo: no trae JSF, así que lo empaquetamos nosotros en el
	WAR.
	-->
		<dependency>
			<groupId>org.glassfish</groupId>
			<artifactId>jakarta.faces</artifactId>
			<version>${faces.version}</version>
		</dependency>
		
		<!--
		API de Servlet: ámbito 'provided' = necesaria para compilar,
		pero NO se empaqueta, porque la aporta el propio Tomcat.
		Incluirla en el WAR provocaría clases duplicadas.
		-->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${servlet.version}</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency>
			<groupId>jakarta.enterprise</groupId>
			<artifactId>jakarta.enterprise.cdi-api</artifactId>
			<version>${cdi.version}</version>
			<scope>provided</scope>
		</dependency>
		
		<!--
		Implementación de CDI (Weld). Tomcat tampoco trae CDI, y desde
		Faces 4.0 CDI es obligatorio.
		-->
		<dependency>
			<groupId>org.jboss.weld.servlet</groupId>
			<artifactId>weld-servlet-shaded</artifactId>
			<version>${weld.version}</version>
		</dependency>
		
		<!-- Pruebas: ámbito 'test' = no se empaqueta en el WAR -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		
		
		<dependency>
			<groupId>org.primefaces</groupId>
			<artifactId>primefaces</artifactId>
			<version>15.0.19</version>
			<classifier>jakarta</classifier>
		</dependency>
		
		<dependency>
			<groupId>org.omnifaces</groupId>
			<artifactId>omnifaces</artifactId>
			<version>4.7.17</version>
		</dependency>

		<dependency>
			<groupId>1.0</groupId>
			<artifactId>Market26</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>com.objectdb</groupId>
			<artifactId>objectdb</artifactId>
			<version>2.8.1</version>
		</dependency>

		<dependency>
			<groupId>org.eclipse.persistence</groupId>
			<artifactId>javax.persistence</artifactId>
			<version>2.1.0</version>
		</dependency>

		<dependency>
			<groupId>javax.transaction</groupId>
			<artifactId>jta</artifactId>
			<version>1.1</version>
		</dependency>

	</dependencies>

	<repositories>
		<repository>
			<id>objectdb</id>
			<name>ObjectDB Repository</name>
			<url>https://m2.objectdb.com</url>
		</repository>
	</repositories>

	<build>
		<!--
			Sin esto el WAR se llamaría login-jsf-0.0.1-SNAPSHOT.war y la
			aplicación se desplegaría en /login-jsf-0.0.1-SNAPSHOT.
			Fijando  la URL es siempre
			http://localhost:8080/LoginJSF
		-->
		<finalName>MarketJSF</finalName>
		
		<plugins>
		<!--
			Fijamos la versión de CADA plugin. Si no se indica, Maven
			elige una por su cuenta y la compilación deja de ser
			reproducible: el mismo código puede construirse distinto
			en dos máquinas o en dos momentos.
		-->
		
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<!-- La configuración la toma de maven.compiler.release -->
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.4.0</version>
			</plugin>
			
			<!-- Necesario para que se ejecuten las pruebas de JUnit 5 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
			
		</plugins>
		
	</build>
	
</project>